.page {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.task {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
}

.top {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.date {
  font-size: 24rpx;
  color: #8C8680;
}

.type {
  font-size: 26rpx;
  font-weight: 600;
  background: #FFEFE7;
  color: #D25B23;
  border-radius: 10rpx;
  padding: 4rpx 14rpx;
}

.status {
  font-size: 24rpx;
  color: #8C8680;
}

.status.ok {
  color: #2E9E5B;
  font-weight: 600;
}

.photo {
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx;
  margin-top: 16rpx;
}

.note {
  display: block;
  font-size: 24rpx;
  color: #8C8680;
  margin-top: 12rpx;
}

.empty {
  padding: 160rpx 0;
  text-align: center;
  color: #8C8680;
  font-size: 26rpx;
}
