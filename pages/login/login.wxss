.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 60rpx 0;
}

.logo {
  font-size: 120rpx;
}

.title {
  margin-top: 24rpx;
  font-size: 44rpx;
  font-weight: 600;
}

.subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #999;
}

.nickname {
  margin-top: 80rpx;
  width: 100%;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  border: 1rpx solid #EAE5DF;
  color: #2D2A26;
}

.wx-btn {
  margin-top: 32rpx;
  width: 100%;
  background: #07c160;
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
}

.wx-btn[disabled] {
  background: #8fdfae;
  color: #fff;
}

.agreement {
  margin-top: 40rpx;
  font-size: 22rpx;
  color: #bbb;
}
