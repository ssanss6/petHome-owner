.page {
  padding: 24rpx;
}

.order {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.no {
  font-size: 24rpx;
  color: #8C8680;
}

.status {
  font-size: 24rpx;
  color: #FF7A45;
  font-weight: 600;
}

.mid {
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 16rpx;
}

.bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.amount {
  font-size: 30rpx;
  color: #FF7A45;
  font-weight: 700;
}

.cage {
  font-size: 22rpx;
  color: #2E9E5B;
}

.empty {
  padding: 160rpx 0;
  text-align: center;
  color: #8C8680;
  font-size: 26rpx;
}

.empty-page {
  padding: 200rpx 60rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-text {
  margin-top: 20rpx;
  color: #8C8680;
  font-size: 26rpx;
}

.login-btn {
  margin-top: 48rpx;
  width: 100%;
  background: #07c160;
  color: #fff;
  border-radius: 48rpx;
}
